FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      chemistryProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

type            kodesChemistryModel;

chemistryType
{
    solver            ode;
    method            kodesChemistryModel;
}

chemistry       on;

initialChemicalTimeStep 1e-7;

odeCoeffs
{
    // kodesSeulex is a line-for-line copy of OpenFOAM's own "seulex"
    // (built in examples/reactingKodesFoam/kodesODESolver) with diagnostic
    // logging added to compare against the KODES GPU Seulex log. Numerically
    // identical to "seulex" - swap back any time with no change in results.
    solver          kodesSeulex;
    absTol          1e-12;
    relTol          1e-1;
}


